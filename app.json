{
  "expo": {
    "name": "Therapy Track",
    "slug": "therapy-track",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "therapytrack",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.therapytrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "org.therapytrack"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "./plugins/withNotifeeResolution",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D86E2",
          "defaultChannel": "therapy-track-group-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8EA6A9",
          "image": "./assets/icon.png"
        }
      ]
    ]
  }
}
